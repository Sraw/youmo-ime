<?xml version="1.0" encoding="UTF-8"?>
<!--
  验收测试用（ST-170、ST-171、ST-173）：数字键盘，改自 App 0.6.2 以前的 number。只管 pads="full phone"（点 123 打开的、各种数字框
  和电话框的），日期框照样用 App 自带的；1 键写「壹」（打出的仍是 1），看得出画的是哪块。其余同 App 的；还留着当时数字密码、小数、
  带负号框的 when="pad=digits…" 条件（那些框现在用 full，这些键和空位不再显示），keyboard-scene 的 NumberPadsTest 拿它看旧布局照样排。
-->
<keyboard xmlns="https://youmo-ime/layout/1" id="uat-number" based-on="number" name="UAT 数字" family="number" pads="full phone" columns="100" preview="off" popups="off">
  <meta author="UAT" version="1.0" license="CC0" description="验收测试用：数字键盘，1 键上写「壹」（打出的仍是 1），只管完整数字键盘和电话框"/>
  <defaults kind="letter" width="22"/>
  <row>
    <key id="+" kind="function" width="16" label="+" text-size="23" send="sym:KP_Add" when="pad=full|phone"/>
    <key id="-" kind="function" width="16" label="-" text-size="23" send="sym:KP_Subtract" when="pad=datetime"/>
    <gap width="16" when="pad=digits|signed|decimal|signed-decimal"/>
    <key id="1" width="fill" label="壹" text-size="30" send="sym:KP_1" shortcut="num/1"/>
    <key id="2" width="fill" label="2" text-size="30" send="sym:KP_2" shortcut="num/2"/>
    <key id="3" width="fill" label="3" text-size="30" send="sym:KP_3" shortcut="num/3"/>
    <key id="backspace" role="backspace" kind="function" width="18" icon="backspace" a11y="a11y_key_backspace"
         sound="delete" send="sym:BackSpace" repeat="true" swipe-axis="both" shortcut="backspace"/>
  </row>
  <row>
    <key id="-" kind="function" width="16" label="-" text-size="23" send="sym:KP_Subtract" when="pad=full"/>
    <key id="*" kind="function" width="16" label="*" text-size="23" send="sym:KP_Multiply" when="pad=phone"/>
    <key id="/" kind="function" width="16" label="/" text-size="23" send="sym:KP_Divide" when="pad=datetime"/>
    <gap width="16" when="pad=digits|signed|decimal|signed-decimal"/>
    <key id="4" width="fill" label="4" text-size="30" send="sym:KP_4" shortcut="num/4"/>
    <key id="5" width="fill" label="5" text-size="30" send="sym:KP_5" shortcut="num/5"/>
    <key id="6" width="fill" label="6" text-size="30" send="sym:KP_6" shortcut="num/6"/>
    <key id="space" role="space" kind="function" width="18" icon="space" a11y="a11y_key_space" sound="space" send="sym:space"
         swipe-axis="both" shortcut="space"/>
  </row>
  <row>
    <key id="*" kind="function" width="16" label="*" text-size="23" send="sym:KP_Multiply" when="pad=full"/>
    <key id="#" kind="function" width="16" label="#" text-size="23" send="commit:#" when="pad=phone"/>
    <key id=":" kind="function" width="16" label=":" text-size="23" send="commit::" when="pad=datetime"/>
    <gap width="16" when="pad=digits|signed|decimal|signed-decimal"/>
    <key id="7" width="fill" label="7" text-size="30" send="sym:KP_7" shortcut="num/7"/>
    <key id="8" width="fill" label="8" text-size="30" send="sym:KP_8" shortcut="num/8"/>
    <key id="9" width="fill" label="9" text-size="30" send="sym:KP_9" shortcut="num/9"/>
    <key id="/" kind="function" width="18" label="/" text-size="23" send="sym:KP_Divide" when="pad=full"/>
    <key id="-" kind="function" width="18" label="-" text-size="23" send="sym:KP_Subtract" when="pad=phone"/>
    <gap width="18" when="pad=digits|signed|decimal|signed-decimal|datetime"/>
  </row>
  <row>
    <key id="symbols" role="symbols" kind="function" width="16" label="符" text-size="16" text-style="bold" send="layout:Symbol"
         shortcut="symbols"/>
    <key id="back" role="back" kind="function" width="14" label="{back}" text-size="16" text-style="bold" send="layout:Text"/>
    <key id="," kind="function" width="8" label="," text-size="23" send="sym:KP_Separator" when="pad=full"/>
    <key id="(" kind="function" width="8" label="(" text-size="23" send="commit:(" when="pad=phone"/>
    <gap width="8" when="pad=digits|signed|decimal|signed-decimal|datetime"/>
    <key id="0" width="22" label="0" text-size="30" send="sym:KP_0" shortcut="num/0"/>
    <key id="=" kind="letter" class="alt-text" width="12" label="=" text-size="23" send="sym:KP_Equal" when="pad=full"/>
    <key id="-" kind="letter" class="alt-text" width="12" label="-" text-size="23" send="sym:KP_Subtract" when="pad=signed|signed-decimal"/>
    <key id=")" kind="letter" class="alt-text" width="12" label=")" text-size="23" send="commit:)" when="pad=phone"/>
    <gap width="12" when="pad=digits|decimal|datetime"/>
    <key id="." kind="function" width="10" label="." text-size="23" send="sym:KP_Decimal" when="pad=full|decimal|signed-decimal|datetime"/>
    <key id="," kind="function" width="10" label="," text-size="23" send="sym:KP_Separator" when="pad=phone"/>
    <gap width="10" when="pad=digits|signed"/>
    <key id="enter" role="enter" kind="enter" face="special" width="18" icon="{return-icon}" a11y="{return}"
         sound="return" send="sym:Return" shortcut="return">
      <menu>
        <item label="Emoji" icon="emoji" do="picker:"/>
      </menu>
    </key>
  </row>
</keyboard>
