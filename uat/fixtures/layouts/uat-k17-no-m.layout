<?xml version="1.0" encoding="UTF-8"?>
<!-- 验收测试用（ST-197）：uat-k17-1.0 去掉 M 键（留出空位），缺字母 m：导入时提醒，拼音照样用它自己的分组打 -->
<keyboard xmlns="https://youmo-ime/layout/1" id="uat-k17-no-m" based-on="k18" name="UAT 17 键缺 M" family="grouped" columns="100">
  <meta author="UAT" version="1.0" license="CC0" description="验收测试用：17 键去掉 M"/>
  <defaults kind="letter" text-size="20" width="fill"/>
  <row>
    <key id="r1c1" label="{group:q}" letters="q" shortcut="g18/q"/>
    <key id="r1c2" label="{group:we}" letters="we" shortcut="g18/we"/>
    <key id="r1c3" label="{group:rt}" letters="rt" shortcut="g18/rt"/>
    <key id="r1c4" label="{group:y}" letters="y" shortcut="g18/y"/>
    <key id="r1c5" label="{group:u}" letters="u" shortcut="g18/u"/>
    <key id="r1c6" label="{group:io}" letters="io" shortcut="g18/io"/>
    <key id="r1c7" label="{group:p}" letters="p" shortcut="g18/p"/>
  </row>
  <row>
    <key id="r2c1" width="fill" label="{group:a}" letters="a" shortcut="g18/a"/>
    <key id="r2c2" width="fill" label="{group:sd}" letters="sd" shortcut="g18/sd"/>
    <key id="r2c3" width="fill" label="{group:fg}" letters="fg" shortcut="g18/fg"/>
    <key id="r2c4" width="fill" label="HJK" letters="hjk" shortcut="uat-k17-no-m/hjk"/>
    <key id="r2c6" width="fill" label="{group:l}" letters="l;" shortcut="g18/l">
      <variant when="ime=shuangpin scheme-types=semicolon" label="{group:l;}"/>
    </key>
  </row>
  <row>
    <key id="apostrophe" role="apostrophe" kind="function" width="15" label="分词" text-size="16" a11y="a11y_key_separator"
         send="'" shortcut="separator"/>
    <key id="r3c1" width="14" label="{group:z}" letters="z" shortcut="g18/z"/>
    <key id="r3c2" width="14" label="{group:xc}" letters="xc" shortcut="g18/xc"/>
    <key id="r3c3" width="14" label="{group:v}" letters="v" shortcut="g18/v"/>
    <key id="r3c4" width="14" label="{group:bn}" letters="bn" shortcut="g18/bn"/>
    <gap width="14"/>
    <key id="backspace" role="backspace" kind="function" width="15" icon="backspace" a11y="a11y_key_backspace"
         sound="delete" send="sym:BackSpace" repeat="true" swipe-axis="both" shortcut="backspace"/>
  </row>
  <include src="grouped-bottom"/>
</keyboard>
