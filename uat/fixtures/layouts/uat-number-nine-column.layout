<?xml version="1.0" encoding="UTF-8"?>
<!-- ST-225：App 的数字键盘，三种 pad 都用，左边的滑动列写 list="nine"（九键那一类，没有 -）；其余照 number.xml。 -->
<keyboard xmlns="https://youmo-ime/layout/1" id="uat-number-nine-column" based-on="number" name="UAT 数字九键列" family="number" pads="full phone datetime" columns="100" preview="off" popups="off">
  <meta author="UAT" version="1.0" license="CC0" description="验收测试用：数字键盘的滑动列是九键那一类，完整的数字键盘缺 -"/>
  <defaults kind="letter" width="22"/>
  <row>
    <slot id="side" kind="scroll" list="nine" width="16" rows="3" look="function" face="keep"/>
    <key id="1" width="fill" label="1" text-size="30" send="sym:KP_1" shortcut="num/1"/>
    <key id="2" width="fill" label="2" text-size="30" send="sym:KP_2" shortcut="num/2"/>
    <key id="3" width="fill" label="3" text-size="30" send="sym:KP_3" shortcut="num/3"/>
    <key id="backspace" role="backspace" kind="function" width="18" icon="backspace" a11y="a11y_key_backspace"
         sound="delete" send="sym:BackSpace" repeat="true" swipe-axis="both" shortcut="backspace"/>
  </row>
  <row>
    <key id="4" width="fill" label="4" text-size="30" send="sym:KP_4" shortcut="num/4"/>
    <key id="5" width="fill" label="5" text-size="30" send="sym:KP_5" shortcut="num/5"/>
    <key id="6" width="fill" label="6" text-size="30" send="sym:KP_6" shortcut="num/6"/>
    <key id="space" role="space" kind="function" width="18" icon="space" a11y="a11y_key_space" sound="space" send="sym:space"
         swipe-axis="both" shortcut="space"/>
  </row>
  <row>
    <key id="7" width="fill" label="7" text-size="30" send="sym:KP_7" shortcut="num/7"/>
    <key id="8" width="fill" label="8" text-size="30" send="sym:KP_8" shortcut="num/8"/>
    <key id="9" width="fill" label="9" text-size="30" send="sym:KP_9" shortcut="num/9"/>
    <key id="=" kind="letter" class="alt-text" width="18" label="=" text-size="23" send="sym:KP_Equal" when="pad=full"/>
    <gap width="18" when="pad=phone|datetime"/>
  </row>
  <row>
    <key id="symbols" role="symbols" kind="function" width="16" label="符" text-size="16" text-style="bold" send="layout:Symbol"
         shortcut="symbols"/>
    <key id="back" role="back" kind="function" width="22" label="{back}" text-size="16" text-style="bold" send="layout:Text"
         long-press="panel-lock"/>
    <key id="0" width="22" label="0" text-size="30" send="sym:KP_0" shortcut="num/0"/>
    <key id="." kind="function" width="22" label="." text-size="23" send="sym:KP_Decimal" when="pad=full|datetime"/>
    <gap width="22" when="pad=phone"/>
    <key id="enter" role="enter" kind="enter" face="special" width="18" icon="{return-icon}" a11y="{return}"
         sound="return" send="sym:Return" shortcut="return">
      <menu>
        <item label="Emoji" icon="emoji" do="picker:"/>
      </menu>
    </key>
  </row>
</keyboard>
