<?xml version="1.0" encoding="UTF-8"?>
<!--
  示例「薄荷 17 键」（060-render-p3 M4）：包里带自己的 18 键键盘 layouts/k18.xml，H 和 JK 并成一个键，成了 17 键；
  动效：键在状态之间 160 ms 过渡（松开时按下的样子淡出，Shift 切换时新旧两面交叉淡），按下缩到 92%、下沉 1dp。
-->
<theme xmlns="https://youmo-ime/theme/4" name="薄荷 17 键" variants="light dark" version="4.0">
  <colors>
    <color name="background" value="#eeeeee"/>
    <color name="bar" value="#eeeeee"/>
    <color name="keyboard" value="#fafafa"/>
    <color name="key" value="#ffffff"/>
    <color name="keyText" value="#212121"/>
    <color name="candidateText" value="#212121"/>
    <color name="candidateLabel" value="#212121"/>
    <color name="candidateComment" value="#6e6e6e"/>
    <color name="altKey" value="#e1e1e1"/>
    <color name="altKeyText" value="#6e6e6e"/>
    <color name="accentKey" value="#1aa37a"/>
    <color name="accentKeyText" value="#ffffff"/>
    <color name="keyPressHighlight" value="#1f000000"/>
    <color name="keyShadow" value="#c2c2c2"/>
    <color name="popupBackground" value="#eeeeee"/>
    <color name="popupText" value="#212121"/>
    <color name="spaceBar" value="#dbdbdb"/>
    <color name="divider" value="#1f000000"/>
    <color name="clipboardEntry" value="#ffffff"/>
    <color name="genericActiveBackground" value="#5e97f6"/>
    <color name="genericActiveForeground" value="#ffffff"/>
    <color name="keyBorder" value="@keyShadow"/>
    <color name="keyHint" value="@altKeyText"/>
    <color name="toolbarIcon" value="@altKeyText"/>
  </colors>
  <colors variant="dark">
    <color name="background" value="#2d2d2d"/>
    <color name="bar" value="#373737"/>
    <color name="keyboard" value="#2d2d2d"/>
    <color name="key" value="#464646"/>
    <color name="keyText" value="#fafafa"/>
    <color name="candidateText" value="#fafafa"/>
    <color name="candidateLabel" value="#fafafa"/>
    <color name="candidateComment" value="#acacac"/>
    <color name="altKey" value="#373737"/>
    <color name="altKeyText" value="#acacac"/>
    <color name="accentKey" value="#5fd4a8"/>
    <color name="keyPressHighlight" value="#33ffffff"/>
    <color name="keyShadow" value="#252525"/>
    <color name="popupBackground" value="#373737"/>
    <color name="popupText" value="#fafafa"/>
    <color name="spaceBar" value="#4a4a4a"/>
    <color name="divider" value="#1fffffff"/>
    <color name="clipboardEntry" value="#464646"/>
    <color name="genericActiveForeground" value="#fafafa"/>
    <color name="accentKeyText" value="#08291d"/>
  </colors>
  <style select="keyboard" fill="@background"/>
  <style select="@flat keyboard" fill="@keyboard"/>
  <style select="bar" fill="transparent"/>
  <style select="panel" fill="transparent"/>
  <style select="@flat panel" fill="@bar"/>
  <style select="key" fill="@key" radius="12dp" border="none" shadow="0 1dp 0 @keyShadow" inset="7dp 3dp" color="@keyText" font="system" weight="400" scale="100%" icon-color="@keyText" press="tint" transition="160ms ease-out"/>
  <style select="@landscape key" inset="4dp 3dp"/>
  <style select="key:pressed" overlay="@keyPressHighlight" press-scale="92%" press-sink="1dp"/>
  <style select="key.function" fill="@altKey" color="@altKeyText" icon-color="@altKeyText"/>
  <style select="key.enter" fill="@accentKey" color="@accentKeyText" icon-color="@accentKeyText"/>
  <style select="key.space" fill="@key"/>
  <style select="key.alt-text" color="@altKeyText" icon-color="@altKeyText"/>
  <style select="key mark, key shortcut" color="@keyHint" icon-color="@keyHint"/>
  <style select="key shortcut" scale="100%"/>
  <style select="key.enter mark" color="@accentKeyText"/>
  <style select="key badge" icon-color="@altKeyText"/>
  <style select="*/reading:on" color="@accentKey" icon-color="@accentKey"/>
  <style select="@flat key" fill="transparent" radius="0" shadow="none"/>
  <style select="@flat key.space" fill="@spaceBar" shape="bar" radius="3dp"/>
  <style select="@flat key.enter" fill="@accentKey" shape="circle"/>
  <style select="preview, popup" fill="@popupBackground" radius="4dp" shadow="0 2dp 2dp #33000000" color="@popupText"/>
  <style select="popup:selected" fill="@genericActiveBackground" color="@genericActiveForeground"/>
  <style select="menu" fill="@accentKey" radius="50%" color="@accentKeyText" icon-color="@accentKeyText"/>
  <style select="menu:selected" overlay="@keyPressHighlight"/>
  <style select="@floating keyboard" radius="7dp"/>
</theme>
