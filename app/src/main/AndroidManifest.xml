<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- remove unused permission from AppCompat -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!-- no permission but these, none for the network above all: any other merged in from a
         dependency fails the build (AndroidAppConventionPlugin) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- voice input, recognized on the phone: nothing heard leaves it. Asked for at the first use,
         and only with the voice pack imported (VoiceFeature) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- other input methods visible on Android 11+ (the IME switcher, the setup's list) -->
    <queries>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <!-- no cloud backup (PRIVACY.md), so the cloud-backup rules and full_backup_content are unused;
         from Android 12 a device-to-device transfer still copies the data (data_extraction_rules) -->
    <application
        android:name=".FcitxApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/app_icon"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/app_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FcitxAppTheme"
        tools:targetApi="33">
        <!-- the app's own language (AppLanguage) kept across starts below Android 13 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <activity
            android:name=".ui.setup.SetupActivity"
            android:exported="false"
            android:launchMode="singleTask" />
        <activity
            android:name=".ui.main.LogActivity"
            android:directBootAware="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:parentActivityName=".ui.main.MainActivity" />
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <!--
                  there has to be so many segments:
                  https://stackoverflow.com/questions/3400072/pathpattern-to-match-file-extension/8599921#8599921
                -->
                <data android:pathPattern=".*\\.dict" />
                <data android:pathPattern=".*\\..*\\.dict" />
                <data android:pathPattern=".*\\..*\\..*\\.dict" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.dict" />
                <data android:pathPattern=".*\\.scel" />
                <data android:pathPattern=".*\\..*\\.scel" />
                <data android:pathPattern=".*\\..*\\..*\\.scel" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.scel" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\..*\\.txt" />
                <data android:pathPattern=".*\\..*\\..*\\.txt" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.txt" />
                <!-- a learning backup, the user dictionary's export (review-uat-fixes N4) -->
                <data android:pathPattern=".*\\.fxlb" />
                <data android:pathPattern=".*\\..*\\.fxlb" />
                <data android:pathPattern=".*\\..*\\..*\\.fxlb" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.fxlb" />
                <!-- pathSuffix works on API 31+ -->
                <data android:pathSuffix=".dict" />
                <data android:pathSuffix=".scel" />
                <data android:pathSuffix=".txt" />
                <data android:pathSuffix=".fxlb" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.main.ClipboardEditActivity"
            android:autoRemoveFromRecents="true"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:label="@string/edit_clipboard"
            android:launchMode="singleInstance"
            android:taskAffinity=".ui.main.ClipboardEditActivity"
            android:theme="@style/Theme.DialogTheme"
            android:windowSoftInputMode="stateAlwaysVisible|adjustPan" />

        <service
            android:name=".input.FcitxInputMethodService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/input_method" />
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:directBootAware="true"
            android:exported="false"
            tools:node="merge">
            <!-- do not inject splitties AppCompat -->
            <meta-data
                android:name="splitties.views.dsl.appcompat.experimental.AppCompatViewInstantiatorInjecter"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <!-- an input method cannot ask for a permission itself: this asks, and closes (finish() in the answer's
             callback). Not noHistory: an activity without history may get no result from one it started, and
             the permission request is one; the answer's callback is the only way to the app's settings -->
        <activity
            android:name=".input.voice.VoicePermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- true only in a test build (-PbuildProfileable=true): simpleperf from the shell -->
        <profileable
            android:shell="${profileableShell}"
            tools:targetApi="29" />
    </application>

</manifest>