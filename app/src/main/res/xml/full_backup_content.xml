<?xml version="1.0" encoding="utf-8"?>
<!-- DataManager.dataDir's assets, in device-protected storage (device_root), synced again on the next start -->
<full-backup-content>
    <exclude
        domain="device_root"
        path="usr" />
    <exclude
        domain="device_root"
        path="descriptor.json" />
    <exclude
        domain="device_root"
        path="README.md" />
    <exclude
        domain="root"
        path="no_backup" />
</full-backup-content>
