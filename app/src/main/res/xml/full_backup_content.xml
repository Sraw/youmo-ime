<?xml version="1.0" encoding="utf-8"?>
<!-- The 0.3.x native host's data in device-protected storage (device_root: usr/, learn/, descriptor.json, README.md),
     left on an install upgraded from 0.3.x and read by nothing;
     the resource packs (device_file packs/), far over the backup's 25 MB. Read on Android 11 and earlier
     only, where allowBackup="false" turns backup and phone-to-phone transfer off anyway: from such a phone
     the packs never move, the new phone imports them again -->
<full-backup-content>
    <exclude
        domain="device_file"
        path="packs" />
    <exclude
        domain="device_root"
        path="usr" />
    <exclude
        domain="device_root"
        path="descriptor.json" />
    <exclude
        domain="device_root"
        path="README.md" />
    <exclude
        domain="device_root"
        path="learn" />
    <exclude
        domain="root"
        path="no_backup" />
</full-backup-content>
