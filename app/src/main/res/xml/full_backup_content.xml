<?xml version="1.0" encoding="utf-8"?>
<!-- DataManager.dataDir's assets, in device-protected storage (device_root), synced again on the next start;
     the resource packs (device_file packs/), far over the backup's 25 MB. Read on Android 11 and earlier
     only, where allowBackup="false" turns backup and phone-to-phone transfer off anyway: from such a phone
     the packs never move, the new phone imports them again -->
<full-backup-content>
    <exclude
        domain="device_file"
        path="packs" />
    <exclude
        domain="device_root"
        path="usr" />
    <exclude
        domain="device_root"
        path="descriptor.json" />
    <exclude
        domain="device_root"
        path="README.md" />
    <exclude
        domain="root"
        path="no_backup" />
</full-backup-content>
