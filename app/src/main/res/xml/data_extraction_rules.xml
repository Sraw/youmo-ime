<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="usr" />
        <exclude
            domain="file"
            path="descriptor.json" />
        <exclude
            domain="file"
            path="licenses.json" />
        <exclude
            domain="file"
            path="README.md" />
        <!-- said outright, though Android leaves it out anyway: the cloud server's settings (CloudServer) -->
        <exclude
            domain="root"
            path="no_backup" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="usr" />
        <exclude
            domain="file"
            path="descriptor.json" />
        <exclude
            domain="file"
            path="licenses.json" />
        <exclude
            domain="file"
            path="README.md" />
        <exclude
            domain="root"
            path="no_backup" />
    </device-transfer>
</data-extraction-rules>