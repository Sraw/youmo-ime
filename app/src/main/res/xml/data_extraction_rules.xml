<?xml version="1.0" encoding="utf-8"?>
<!-- DataManager.dataDir's assets, synced again on the next start, live in device-protected
     storage (device_root), not in files/ -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="device_root"
            path="usr" />
        <exclude
            domain="device_root"
            path="descriptor.json" />
        <exclude
            domain="device_root"
            path="README.md" />
        <exclude
            domain="root"
            path="no_backup" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="device_root"
            path="usr" />
        <exclude
            domain="device_root"
            path="descriptor.json" />
        <exclude
            domain="device_root"
            path="README.md" />
        <exclude
            domain="root"
            path="no_backup" />
    </device-transfer>
</data-extraction-rules>
