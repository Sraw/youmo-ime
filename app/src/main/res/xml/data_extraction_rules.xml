<?xml version="1.0" encoding="utf-8"?>
<!-- DataManager.dataDir's assets, synced again on the next start, live in device-protected
     storage (device_root), not in files/. The clipboard history (databases/clbdb and its journals)
     stays on the phone, and the one made in device-protected storage (device_database) by a start
     before the first unlock: it holds clips marked sensitive, a password from a password manager say,
     which the app's own export takes out (UserDataManager) and these rules cannot. The resource packs
     (PackStore, device_file packs/, some 300-500 MB) are over cloud backup's 25 MB, which would lose
     the whole backup; a phone-to-phone transfer takes them, so the new phone need not import again
     (their signatures are checked again when loaded) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="device_file"
            path="packs" />
        <exclude
            domain="device_root"
            path="usr" />
        <exclude
            domain="device_root"
            path="descriptor.json" />
        <exclude
            domain="device_root"
            path="README.md" />
        <exclude
            domain="root"
            path="no_backup" />
        <exclude
            domain="database"
            path="clbdb" />
        <exclude
            domain="database"
            path="clbdb-wal" />
        <exclude
            domain="database"
            path="clbdb-shm" />
        <exclude
            domain="database"
            path="clbdb-journal" />
        <exclude
            domain="device_database"
            path="clbdb" />
        <exclude
            domain="device_database"
            path="clbdb-wal" />
        <exclude
            domain="device_database"
            path="clbdb-shm" />
        <exclude
            domain="device_database"
            path="clbdb-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="device_root"
            path="usr" />
        <exclude
            domain="device_root"
            path="descriptor.json" />
        <exclude
            domain="device_root"
            path="README.md" />
        <exclude
            domain="root"
            path="no_backup" />
        <exclude
            domain="database"
            path="clbdb" />
        <exclude
            domain="database"
            path="clbdb-wal" />
        <exclude
            domain="database"
            path="clbdb-shm" />
        <exclude
            domain="database"
            path="clbdb-journal" />
        <exclude
            domain="device_database"
            path="clbdb" />
        <exclude
            domain="device_database"
            path="clbdb-wal" />
        <exclude
            domain="device_database"
            path="clbdb-shm" />
        <exclude
            domain="device_database"
            path="clbdb-journal" />
    </device-transfer>
</data-extraction-rules>
