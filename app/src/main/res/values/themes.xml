<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- shared by light and night; only the log colors differ (see values-night) -->
    <style name="Base.Theme.FcitxAppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="alertDialogTheme">@style/ThemeOverlay.Fcitx.Dialog.Alert</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.Fcitx</item>
    </style>

    <style name="Theme.FcitxAppTheme" parent="Base.Theme.FcitxAppTheme">
        <item name="colorLogFatal">@color/red_A700</item>
        <item name="colorLogError">@color/red_400</item>
        <item name="colorLogWarning">@color/yellow_800</item>
        <item name="colorLogInfo">@color/blue_500</item>
        <item name="colorLogDebug">@color/grey_700</item>
        <item name="colorLogVerbose">@color/grey_700</item>
    </style>

    <!--
    AppCompat dialogs (including the preference dialogs, which we can't hand a
    MaterialAlertDialogBuilder) fall back to the platform's grey, square-cornered panel
    under Material 3; give them the M3 surface and corner radius instead.
    -->
    <style name="ThemeOverlay.Fcitx.Dialog.Alert" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
    </style>

    <style name="PreferenceThemeOverlay.Fcitx" parent="PreferenceThemeOverlay">
        <item name="switchPreferenceCompatStyle">@style/Preference.SwitchPreferenceCompat.Fcitx</item>
    </style>

    <style name="Preference.SwitchPreferenceCompat.Fcitx" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="widgetLayout">@layout/preference_widget_material_switch</item>
    </style>

    <style name="Theme.InputViewTheme" parent="@android:style/Theme.DeviceDefault.Settings" />

    <style name="Theme.DialogTheme" parent="@android:style/Theme.DeviceDefault.Light.Dialog" />

    <style name="InputViewSnackbarTheme" parent="Theme.MaterialComponents.Light.NoActionBar" />
</resources>
