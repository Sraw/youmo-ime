<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!--
            An editor for the instrumented SoftKeyboardTest to type into. It has to be in the
            app itself: activities from the test APK run as another user, in another process
            from the input method. Debug builds only, and not exported.
        -->
        <activity
            android:name="org.fcitx.fcitx5.android.input.TypingHostActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <!--
            The device UAT's idle signal (uat.py Device.idle): exported so the shell can query it,
            behind DUMP, which the shell holds and no app can get (it tells whether you are typing).
            Debug builds only.
        -->
        <provider
            android:name="org.fcitx.fcitx5.android.debug.UatIdleProvider"
            android:authorities="${applicationId}.uat.idle"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!--
            The device UAT's clip microphone (uat.py Device.say): exported for the shell's
            `content call` and `content write`, behind DUMP, which only the shell or the system
            holds, or an app it is granted to over adb; the provider itself takes only the shell's
            and root's uid too. ExportedContentProvider is ignored because exported is the point
            and DUMP the guard. Debug builds only.
        -->
        <provider
            android:name="org.fcitx.fcitx5.android.debug.VoiceClipProvider"
            android:authorities="${applicationId}.voiceclip"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedContentProvider" />

        <!--
            The device UAT's pack import (uat.py Device.import_packs): a pack file written in from
            the shell, then imported through the same PackStore.import as the settings page's, the
            same checks, signature and all (a debug build trusts the test key's packs and the
            release's). The shell's uid only, behind DUMP. Debug builds only.
        -->
        <provider
            android:name="org.fcitx.fcitx5.android.debug.PackImportProvider"
            android:authorities="${applicationId}.uat.packs"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedContentProvider" />
    </application>

</manifest>
