<?xml version="1.0" encoding="UTF-8"?>
<!--
  手写（HandwritingKeyboard，rules C §8），板 handwriting（没有位置键名，键按角色）。手写板是跨四行的 slot，宽 85，
  按字母键面画、平铺也画块（face="keep"）、不画按下；，。没有气泡（preview="off"，同旧 View），长按的标点作为按键发给输入法（同旧 View，不写 as-is）；给它一个名字 pad，主题能写 handwriting/pad（rules C 疑问 2 的回答）。
  右列各 15：⌫、，、。、注；，。按标点映射显示（{punct:,}），和发出去的一致（rules C 疑问 4，060-render-p2 §5.3 S5b 故意不同；旧 View 固定显示全角）。注 键开着时（状态 :on）字色是强调色，主题写。
  第 5 行：符 15、123 14（无长按）、空格、语言键 10、回车 15。
-->
<keyboard xmlns="https://youmo-ime/layout/1" id="handwriting" name="手写" family="handwriting" columns="100">
  <defaults kind="function" width="15" text-size="20"/>
  <row>
    <slot id="pad" kind="handwriting-pad" width="85" rows="4" look="letter" face="keep"/>
    <key id="backspace" role="backspace" kind="function" width="15" icon="backspace" a11y="a11y_key_backspace"
         sound="delete" send="sym:BackSpace" repeat="true" swipe-axis="both" shortcut="backspace"/>
  </row>
  <row>
    <key id="comma" role="comma" label="{punct:,}" preview="off" send=",">
      <popup from="list">
        <item text="？"/><item text="！"/><item text="："/><item text="；"/><item text="、"/><item text="…"/><item text="“"/><item text="”"/>
      </popup>
    </key>
  </row>
  <row>
    <key id="period" role="period" label="{punct:.}" preview="off" send=".">
      <popup from="none"/>
    </key>
  </row>
  <row>
    <key id="reading" role="reading" label="注" a11y="a11y_key_reading" send="reading">
      <menu>
        <item label="reading_off" do="reading:off"/>
        <item label="reading_pinyin" do="reading:pinyin"/>
        <item label="reading_zhuyin" do="reading:zhuyin"/>
      </menu>
    </key>
  </row>
  <row>
    <key id="symbols" role="symbols" kind="function" width="15" label="符" text-size="16" text-style="bold"
         send="layout:Symbol" long-press="quickphrase" shortcut="symbols"/>
    <key id="numbers" role="numbers" kind="function" width="14" label="123" text-size="16" text-style="bold"
         send="layout:Number" shortcut="numbers"/>
    <key id="space" role="space" kind="space" face="special" width="fill" label="{ime-name}" text-size="13"
         badge="{hold-badge}" sound="space" send="sym:space" long-press="space-long-press" swipe-axis="both" shortcut="space"/>
    <key id="lang" role="lang" kind="letter" class="alt-text" width="10" icon="language" a11y="a11y_key_switch_language"
         shortcut="lang" send="lang" long-press="ime-picker" when="lang-key"/>
    <key id="enter" role="enter" kind="enter" face="special" width="15" icon="{return-icon}" a11y="{return}"
         sound="return" send="sym:Return" shortcut="return">
      <menu>
        <item label="emoji" icon="emoji" do="picker:Emoji"/>
      </menu>
    </key>
  </row>
</keyboard>
