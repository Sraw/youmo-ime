<?xml version="1.0" encoding="UTF-8"?>
<!--
  14 键（GroupedKeyboard：Grouped14、GroupedShuangpin14，rules C §3），板 k14。宽度为行宽的百分之几：前两行每组 20，
  第 3 行 分词 15 + 四组各 17.5 + ⌫ 15。组键：组字母 20 号（{group:qw}：大写，拼音键字母大小写另定），角标（讯飞）1–0 ~ ! @ ?（KeyDefaults.CORNERS14，按组的位置）；
  键名按位置 r1c1…，快捷键 g14/<小写组字母>。组的字母写在 letters= 上（060-render-v2 §15「自定义字母分组」）：点按发这组的组码
  （App 从布局收集各组拼成 NineKeyLetters，须等于 G14；按落点加权：letters="as" 是一行两格，点在哪半边哪个字母权重高，
  060-render-v2 §15「按落点加权」），角标是长按的首个，上滑发它（数字为小键盘数字，标记按标点映射显示）；
  长按由 KeyDefaults.grouped 按 letters 拼（大写 + 首个 + 小写 + 这些字母内置的符号），用户的 key_lists 盖上去（060-keys-unify）。读屏文字不写，引擎拼成「Q W, 1」
  （字母逐个、逗号、角标如显示）。
-->
<keyboard xmlns="https://youmo-ime/layout/1" id="k14" name="14 键" family="grouped" columns="100">
  <defaults kind="letter" text-size="20" width="20"/>
  <row>
    <key id="r1c1" label="{group:qw}" letters="qw" shortcut="g14/qw"/>
    <key id="r1c2" label="{group:er}" letters="er" shortcut="g14/er"/>
    <key id="r1c3" label="{group:ty}" letters="ty" shortcut="g14/ty"/>
    <key id="r1c4" label="{group:ui}" letters="ui" shortcut="g14/ui"/>
    <key id="r1c5" label="{group:op}" letters="op" shortcut="g14/op"/>
  </row>
  <row>
    <key id="r2c1" label="{group:as}" letters="as" shortcut="g14/as"/>
    <key id="r2c2" label="{group:df}" letters="df" shortcut="g14/df"/>
    <key id="r2c3" label="{group:gh}" letters="gh" shortcut="g14/gh"/>
    <key id="r2c4" label="{group:jk}" letters="jk" shortcut="g14/jk"/>
    <key id="r2c5" label="{group:l}" letters="l" shortcut="g14/l"/>
  </row>
  <row>
    <key id="apostrophe" role="apostrophe" kind="function" width="15" label="分词" text-size="16" a11y="a11y_key_separator"
         send="'" shortcut="separator"/>
    <key id="r3c1" width="17.5" label="{group:zx}" letters="zx" shortcut="g14/zx"/>
    <key id="r3c2" width="17.5" label="{group:cv}" letters="cv" shortcut="g14/cv"/>
    <key id="r3c3" width="17.5" label="{group:bn}" letters="bn" shortcut="g14/bn"/>
    <key id="r3c4" width="17.5" label="{group:m}" letters="m" shortcut="g14/m"/>
    <key id="backspace" role="backspace" kind="function" width="15" icon="backspace" a11y="a11y_key_backspace"
         sound="delete" send="sym:BackSpace" repeat="true" swipe-axis="both" shortcut="backspace"/>
  </row>
  <include src="grouped-bottom"/>
</keyboard>
