<?xml version="1.0" encoding="UTF-8"?>
<!--
  注音九键（ZhuyinKeyboard nine=true，ZhuyinNine，rules C §6），板 zhuyin-nine，键名为 4×5 格的位置（⌫ 按角色，没有 r1c5）。
  每行：声调列 14、三组各 24、右列 14（宽度为行宽的百分之几）；第 5 行是分组底行。组键 18 号、声调 20 号、? ! ~ 23 号。
  第 4 行第 4 格（r4c4）未输入时显示逗号（按标点映射），输入中显示「分词」；它的动作随输入中变是 App 行为。
  它就是 ，（fn/comma）：长按、上下滑、标记都是 ， 的，所有键盘一份（060-keys-unify §5.2）。
  声调 ˉ ˊ ˇ ˋ 发 action:tone-1…4，˙ 是 tone-5（ˉ 的长按与首个，zy9/tone-1）；声调和 ? ! ~ 有名字（zy9/tone-N、question、exclam、tilde），
  用户可以给它们设长按和滑动（060-keys-unify D2）。
  组键：action:zhuyin 按键面的符号发这组的组码，长按 from="group" 是这组的各个符号（App 按键面拼，选中的符号转码）；
  不写 letters=：注音符号不是 a–z 的分组，组码是注音会话自己的（Keyboard.zhuyinNineKey），没有落点加权（060-render-p2 S4d）。
  气泡：声调和 ? ! ~ 是功能键也有（preview="on"，旧的 Preview），slot 是字母键却没有（preview="off"）。
  ? ! ~ 按标点映射显示（{punct:?}），和发出去的一致（rules C 疑问 5，060-render-p2 §5.3 故意不同；旧 View 显示半角）。
-->
<keyboard xmlns="https://youmo-ime/layout/1" id="zhuyin-nine" name="注音九键" family="zhuyin-nine" columns="100">
  <defaults kind="letter" text-size="20" width="24" mark="false"/>
  <row>
    <key id="r1c1" kind="function" width="14" label="ˉ" preview="on" send="action:tone-1" shortcut="zy9/tone-1">
      <popup from="list">
        <item text="˙" send="action:tone-5"/>
      </popup>
    </key>
    <key id="r1c2" label="ㄅㄉㄚ" text-size="18" send="action:zhuyin" shortcut="zy9/1">
      <popup from="group"/>
    </key>
    <key id="r1c3" label="ㄍㄐㄞ" text-size="18" send="action:zhuyin" shortcut="zy9/2">
      <popup from="group"/>
    </key>
    <key id="r1c4" label="ㄓㄗㄢㄦ" text-size="18" send="action:zhuyin" shortcut="zy9/3">
      <popup from="group"/>
    </key>
    <key id="backspace" role="backspace" kind="function" width="14" icon="backspace" a11y="a11y_key_backspace"
         sound="delete" send="sym:BackSpace" repeat="true" swipe-axis="both" shortcut="backspace"/>
  </row>
  <row>
    <key id="r2c1" kind="function" width="14" label="ˊ" preview="on" send="action:tone-2" shortcut="zy9/tone-2"/>
    <key id="r2c2" label="ㄆㄊㄛ" text-size="18" send="action:zhuyin" shortcut="zy9/4">
      <popup from="group"/>
    </key>
    <key id="r2c3" label="ㄎㄑㄟ" text-size="18" send="action:zhuyin" shortcut="zy9/5">
      <popup from="group"/>
    </key>
    <key id="r2c4" label="ㄔㄘㄣㄧ" text-size="18" send="action:zhuyin" shortcut="zy9/6">
      <popup from="group"/>
    </key>
    <key id="r2c5" kind="function" width="14" label="{punct:?}" text-size="23" preview="on" send="?" shortcut="zy9/question"/>
  </row>
  <row>
    <key id="r3c1" kind="function" width="14" label="ˇ" preview="on" send="action:tone-3" shortcut="zy9/tone-3"/>
    <key id="r3c2" label="ㄇㄋㄜ" text-size="18" send="action:zhuyin" shortcut="zy9/7">
      <popup from="group"/>
    </key>
    <key id="r3c3" label="ㄏㄒㄠㄡ" text-size="18" send="action:zhuyin" shortcut="zy9/8">
      <popup from="group"/>
    </key>
    <key id="r3c4" label="ㄕㄙㄤㄨ" text-size="18" send="action:zhuyin" shortcut="zy9/9">
      <popup from="group"/>
    </key>
    <key id="r3c5" kind="function" width="14" label="{punct:!}" text-size="23" preview="on" send="!" shortcut="zy9/exclam"/>
  </row>
  <row>
    <key id="r4c1" kind="function" width="14" label="ˋ" preview="on" send="action:tone-4" shortcut="zy9/tone-4"/>
    <key id="r4c2" label="ㄈㄌㄝ" text-size="18" send="action:zhuyin" shortcut="zy9/10">
      <popup from="group"/>
    </key>
    <key id="r4c3" label="ㄖㄥㄩ" text-size="18" send="action:zhuyin" shortcut="zy9/11">
      <popup from="group"/>
    </key>
    <key id="r4c4" label="{punct:,}" text-size="18" preview="off" send="action:zhuyin-slot" shortcut="fn/comma">
      <variant when="composing" label="分词"/>
    </key>
    <key id="r4c5" kind="function" width="14" label="{punct:~}" text-size="23" preview="on" send="~" shortcut="zy9/tilde"/>
  </row>
  <include src="grouped-bottom"/>
</keyboard>
