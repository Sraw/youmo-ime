<?xml version="1.0" encoding="UTF-8"?>
<!--
  18 键（GroupedKeyboard：GroupedPinyin18、Grouped18、Grouped18Plain，rules C §3），板 k18（拼音 18 和双拼 18 共用）。
  第 1 行 7 组、第 2 行 6 组各占满（fill 平分），第 3 行 分词 15 + 五组各 14 + ⌫ 15。角标 1–0 ( ) - ~ ! @ ? :。
  第 2 行最后一组在双拼方案打 ; 时是 L;（Grouped18），否则 L（拼音 18、Grouped18Plain），用 variant 写（读「L ;, -」）。
  M 的角标 : 上滑发 :（过输入法，同现在的 HostKeyAction(":")）。其余同 14 键。
-->
<keyboard xmlns="https://youmo-ime/layout/1" id="k18" name="18 键" family="grouped" columns="100">
  <defaults kind="letter" text-size="20" width="fill"/>
  <row>
    <key id="r1c1" label="Q" alt="1" letters="q" swipe-up="keypad:1"
         shortcut="g18/q"/>
    <key id="r1c2" label="WE" alt="2" letters="we" swipe-up="keypad:2"
         shortcut="g18/we"/>
    <key id="r1c3" label="RT" alt="3" letters="rt" swipe-up="keypad:3"
         shortcut="g18/rt"/>
    <key id="r1c4" label="Y" alt="4" letters="y" swipe-up="keypad:4"
         shortcut="g18/y"/>
    <key id="r1c5" label="U" alt="5" letters="u" swipe-up="keypad:5"
         shortcut="g18/u"/>
    <key id="r1c6" label="IO" alt="6" letters="io" swipe-up="keypad:6"
         shortcut="g18/io"/>
    <key id="r1c7" label="P" alt="7" letters="p" swipe-up="keypad:7"
         shortcut="g18/p"/>
  </row>
  <row>
    <key id="r2c1" width="fill" label="A" alt="8" letters="a" swipe-up="keypad:8"
         shortcut="g18/a"/>
    <key id="r2c2" width="fill" label="SD" alt="9" letters="sd" swipe-up="keypad:9"
         shortcut="g18/sd"/>
    <key id="r2c3" width="fill" label="FG" alt="0" letters="fg" swipe-up="keypad:0"
         shortcut="g18/fg"/>
    <key id="r2c4" width="fill" label="H" alt="{punct:(}" letters="h" swipe-up="("
         shortcut="g18/h"/>
    <key id="r2c5" width="fill" label="JK" alt="{punct:)}" letters="jk" swipe-up=")"
         shortcut="g18/jk"/>
    <key id="r2c6" width="fill" label="L" alt="{punct:-}" letters="l;" swipe-up="-"
         shortcut="g18/l">
      <variant when="ime=shuangpin scheme-types=semicolon" label="L;"/>
    </key>
  </row>
  <row>
    <key id="apostrophe" role="apostrophe" kind="function" width="15" label="分词" text-size="16" a11y="a11y_key_separator"
         send="'" shortcut="separator"/>
    <key id="r3c1" width="14" label="Z" alt="{punct:~}" letters="z" swipe-up="~"
         shortcut="g18/z"/>
    <key id="r3c2" width="14" label="XC" alt="{punct:!}" letters="xc" swipe-up="!"
         shortcut="g18/xc"/>
    <key id="r3c3" width="14" label="V" alt="{punct:@}" letters="v" swipe-up="@"
         shortcut="g18/v"/>
    <key id="r3c4" width="14" label="BN" alt="{punct:?}" letters="bn" swipe-up="?"
         shortcut="g18/bn"/>
    <key id="r3c5" width="14" label="M" alt="{punct::}" letters="m" swipe-up=":"
         shortcut="g18/m"/>
    <key id="backspace" role="backspace" kind="function" width="15" icon="backspace" a11y="a11y_key_backspace"
         sound="delete" send="sym:BackSpace" repeat="true" swipe-axis="both" shortcut="backspace"/>
  </row>
  <include src="grouped-bottom"/>
</keyboard>
