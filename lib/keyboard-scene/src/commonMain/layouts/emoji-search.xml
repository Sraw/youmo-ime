<?xml version="1.0" encoding="UTF-8"?>
<!--
  表情搜索的字母键（EmojiSearchUi.Keyboard，060-render-p2 S6），板 emoji-search。三行字母，键的动作交给面板（PickerWindow 的
  EmojiSearchQuery）：字母键是 key:（HostKeyAction，面板按字母拼查询），按下有气泡，不弹长按键盘（每个字母键 <popup from="none"/>，旧 LetterKey 只有气泡；060-keys-unify §5：长按由键自己说，不由整板说）。
  第三行：返回 15（emoji-search:off，字在 Shift 的位置，所以这一行和字母一样宽）、z…m、⌫ 15。
  ⌫ 不写 role="backspace"：它只删查询，旁滑不选字段里的字（旧的 Backspace 键不是 BackspaceKey，没有选字滑动）；
  按住连删时 App 给的动作带 Repeat 状态（EmojiSearchUi 的 sceneTable.repeat），面板据此清空查询而不删到字段里。
  ⌫ 有名字（fn/backspace，060-keys-unify J1）：上下滑的槽和角标同各键盘的 ⌫，槽里的清空、恢复作用于查询（PickerWindow）。
-->
<keyboard xmlns="https://youmo-ime/layout/1" id="emoji-search" name="表情搜索" family="emoji-search" columns="10">
  <defaults kind="letter" text-size="23"/>
  <row>
    <key id="q" label="q" send="q"><popup from="none"/></key>
    <key id="w" label="w" send="w"><popup from="none"/></key>
    <key id="e" label="e" send="e"><popup from="none"/></key>
    <key id="r" label="r" send="r"><popup from="none"/></key>
    <key id="t" label="t" send="t"><popup from="none"/></key>
    <key id="y" label="y" send="y"><popup from="none"/></key>
    <key id="u" label="u" send="u"><popup from="none"/></key>
    <key id="i" label="i" send="i"><popup from="none"/></key>
    <key id="o" label="o" send="o"><popup from="none"/></key>
    <key id="p" label="p" send="p"><popup from="none"/></key>
  </row>
  <row>
    <key id="a" label="a" send="a"><popup from="none"/></key>
    <key id="s" label="s" send="s"><popup from="none"/></key>
    <key id="d" label="d" send="d"><popup from="none"/></key>
    <key id="f" label="f" send="f"><popup from="none"/></key>
    <key id="g" label="g" send="g"><popup from="none"/></key>
    <key id="h" label="h" send="h"><popup from="none"/></key>
    <key id="j" label="j" send="j"><popup from="none"/></key>
    <key id="k" label="k" send="k"><popup from="none"/></key>
    <key id="l" label="l" send="l"><popup from="none"/></key>
  </row>
  <row>
    <key id="back" role="back" kind="function" width="1.5" label="{back}" text-size="16" text-style="bold" send="emoji-search:off"/>
    <key id="z" label="z" send="z"><popup from="none"/></key>
    <key id="x" label="x" send="x"><popup from="none"/></key>
    <key id="c" label="c" send="c"><popup from="none"/></key>
    <key id="v" label="v" send="v"><popup from="none"/></key>
    <key id="b" label="b" send="b"><popup from="none"/></key>
    <key id="n" label="n" send="n"><popup from="none"/></key>
    <key id="m" label="m" send="m"><popup from="none"/></key>
    <key id="backspace" kind="function" width="1.5" icon="backspace" a11y="a11y_key_backspace" sound="delete" send="sym:BackSpace" repeat="true" shortcut="backspace"/>
  </row>
</keyboard>
