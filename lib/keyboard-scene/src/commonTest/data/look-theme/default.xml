<?xml version="1.0" encoding="UTF-8"?>
<theme xmlns="https://youmo-ime/theme/4" name="default" dark="false" version="4.0">
  <colors>
    <color name="background" value="#ffeceff1"/>
    <color name="bar" value="#ffe4e7e9"/>
    <color name="keyboard" value="#ffeceff1"/>
    <color name="key" value="#fffbfbfc"/>
    <color name="keyText" value="#ff37474f"/>
    <color name="candidateText" value="#ff37474f"/>
    <color name="candidateLabel" value="#ff37474f"/>
    <color name="candidateComment" value="#ff7a858a"/>
    <color name="altKey" value="#ffdfe2e4"/>
    <color name="altKeyText" value="#ff7a858a"/>
    <color name="accentKey" value="#ff5cb5ab"/>
    <color name="accentKeyText" value="#ffffffff"/>
    <color name="keyPressHighlight" value="#1f000000"/>
    <color name="keyShadow" value="#ffc0c3c4"/>
    <color name="popupBackground" value="#ffd9dbdd"/>
    <color name="popupText" value="#ff37474f"/>
    <color name="spaceBar" value="#ffc9ced1"/>
    <color name="divider" value="#1f000000"/>
    <color name="clipboardEntry" value="#fffbfbfc"/>
    <color name="genericActiveBackground" value="#ff80cbc4"/>
    <color name="genericActiveForeground" value="#ff37474f"/>
    <color name="keyBorder" value="#ffc0c3c4"/>
    <color name="keyHint" value="#ff7a858a"/>
    <color name="toolbarIcon" value="#ff7a858a"/>
  </colors>
  <style select="keyboard" fill="@background"/>
  <style select="@flat keyboard" fill="@keyboard"/>
  <style select="bar" fill="transparent"/>
  <style select="panel" fill="transparent"/>
  <style select="@flat panel" fill="@bar"/>
  <style select="key" fill="@key" radius="4dp" border="none" shadow="0 1dp 0 @keyShadow" inset="7dp 3dp" color="@keyText" icon-color="@keyText" font="system" weight="400" scale="100%" press="tint"/>
  <style select="@landscape key" inset="4dp 3dp"/>
  <style select="key:pressed" overlay="@keyPressHighlight"/>
  <style select="key.function" fill="@altKey" color="@altKeyText" icon-color="@altKeyText"/>
  <style select="key.enter" fill="@accentKey" color="@accentKeyText" icon-color="@accentKeyText"/>
  <style select="key.space" fill="@key"/>
  <style select="key.alt-text" color="@altKeyText" icon-color="@altKeyText"/>
  <style select="key mark, key shortcut" color="@keyHint" icon-color="@keyHint"/>
  <style select="key shortcut" scale="100%"/>
  <style select="key.enter mark" color="@accentKeyText"/>
  <style select="key badge" icon-color="@altKeyText"/>
  <style select="*/reading:on" color="@accentKey" icon-color="@accentKey"/>
  <style select="@flat key" fill="transparent" shadow="none" radius="0"/>
  <style select="@flat key.space" fill="@spaceBar" shape="bar" radius="3dp"/>
  <style select="@flat key.enter" fill="@accentKey" shape="circle"/>
  <style select="preview, popup" fill="@popupBackground" color="@popupText" radius="4dp" shadow="0 2dp 2dp #33000000"/>
  <style select="popup:selected" fill="@genericActiveBackground" color="@genericActiveForeground"/>
  <style select="menu" fill="@accentKey" color="@accentKeyText" icon-color="@accentKeyText" radius="50%"/>
  <style select="menu:selected" overlay="@keyPressHighlight"/>
  <style select="@floating keyboard" radius="7dp"/>
  <style select="handle" fill="mix(@background, @keyText, 10%)"/>
</theme>
