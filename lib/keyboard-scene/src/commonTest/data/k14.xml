<?xml version="1.0" encoding="UTF-8"?>
<!--
  14 键（GroupedKeyboard：Grouped14、GroupedShuangpin14，rules C §3），板 k14。宽度为行宽的百分之几：前两行每组 20，
  第 3 行 分词 15 + 四组各 17.5 + ⌫ 15。组键：组字母大写 20 号，角标（讯飞）1–0 ~ ! @ ?，~ ! @ ? 按标点映射显示（{punct:~}）；
  键名按位置 r1c1…，快捷键 g14/<小写组字母>。点按发组码（App 按落点加权，send="action:group" 只是占位）、上滑发角标（数字为小键盘数字），
  长按是组合式的（大写 + 角标 + 小写 + 这些字母在 26 键的长按符号），App 按 from="group" 拼。读屏文字不写，引擎拼成「Q W, 1」
  （字母逐个、逗号、角标如显示）。
-->
<keyboard xmlns="https://youmo-ime/layout/1" id="k14" name="14 键" family="grouped" columns="100">
  <defaults kind="letter" text-size="20" width="20"/>
  <row>
    <key id="r1c1" label="QW" alt="1" send="action:group" swipe-up="keypad:1"
         shortcut="g14/qw">
      <popup from="group"/>
    </key>
    <key id="r1c2" label="ER" alt="2" send="action:group" swipe-up="keypad:2"
         shortcut="g14/er">
      <popup from="group"/>
    </key>
    <key id="r1c3" label="TY" alt="3" send="action:group" swipe-up="keypad:3"
         shortcut="g14/ty">
      <popup from="group"/>
    </key>
    <key id="r1c4" label="UI" alt="4" send="action:group" swipe-up="keypad:4"
         shortcut="g14/ui">
      <popup from="group"/>
    </key>
    <key id="r1c5" label="OP" alt="5" send="action:group" swipe-up="keypad:5"
         shortcut="g14/op">
      <popup from="group"/>
    </key>
  </row>
  <row>
    <key id="r2c1" label="AS" alt="6" send="action:group" swipe-up="keypad:6"
         shortcut="g14/as">
      <popup from="group"/>
    </key>
    <key id="r2c2" label="DF" alt="7" send="action:group" swipe-up="keypad:7"
         shortcut="g14/df">
      <popup from="group"/>
    </key>
    <key id="r2c3" label="GH" alt="8" send="action:group" swipe-up="keypad:8"
         shortcut="g14/gh">
      <popup from="group"/>
    </key>
    <key id="r2c4" label="JK" alt="9" send="action:group" swipe-up="keypad:9"
         shortcut="g14/jk">
      <popup from="group"/>
    </key>
    <key id="r2c5" label="L" alt="0" send="action:group" swipe-up="keypad:0"
         shortcut="g14/l">
      <popup from="group"/>
    </key>
  </row>
  <row>
    <key id="apostrophe" role="apostrophe" kind="function" width="15" label="分词" text-size="16" a11y="分词"
         send="'" shortcut="separator"/>
    <key id="r3c1" width="17.5" label="ZX" alt="{punct:~}" send="action:group" swipe-up="~"
         shortcut="g14/zx">
      <popup from="group"/>
    </key>
    <key id="r3c2" width="17.5" label="CV" alt="{punct:!}" send="action:group" swipe-up="!"
         shortcut="g14/cv">
      <popup from="group"/>
    </key>
    <key id="r3c3" width="17.5" label="BN" alt="{punct:@}" send="action:group" swipe-up="@"
         shortcut="g14/bn">
      <popup from="group"/>
    </key>
    <key id="r3c4" width="17.5" label="M" alt="{punct:?}" send="action:group" swipe-up="?"
         shortcut="g14/m">
      <popup from="group"/>
    </key>
    <key id="backspace" role="backspace" kind="function" width="15" icon="backspace" a11y="a11y_key_backspace"
         sound="delete" send="sym:BackSpace" repeat="true" swipe-axis="both" shortcut="backspace"/>
  </row>
  <include src="grouped-bottom"/>
</keyboard>
