<?xml version="1.0" encoding="UTF-8"?>
<!--
  A layout's own 17 keys (060-render-p3 T9a): the 14 keys' groups and three more, p on two keys, one key of
  two rows (pq rs) and one of three letters, so the engine's own keyboard (NineKeyLetters.custom) and a tap's
  place in two dimensions are tried on it. Test data, no keyboard the app ships.
-->
<keyboard xmlns="https://youmo-ime/layout/1" id="k17" name="17 键" family="grouped" columns="100">
  <defaults kind="letter" text-size="20" width="16.5"/>
  <row>
    <key id="r1c1" label="QW" letters="qw"/>
    <key id="r1c2" label="ER" letters="er"/>
    <key id="r1c3" label="TY" letters="ty"/>
    <key id="r1c4" label="UI" letters="ui"/>
    <key id="r1c5" label="OP" letters="op"/>
    <key id="r1c6" label="AS" letters="as"/>
  </row>
  <row>
    <key id="r2c1" label="DF" letters="df"/>
    <key id="r2c2" label="GH" letters="gh"/>
    <key id="r2c3" label="JK" letters="jk"/>
    <key id="r2c4" label="L" letters="l"/>
    <key id="r2c5" label="ZX" letters="zx"/>
    <key id="r2c6" label="CV" letters="cv"/>
  </row>
  <row>
    <key id="r3c1" width="20" label="BN" letters="bn"/>
    <key id="r3c2" width="20" label="M" letters="m"/>
    <key id="r3c3" width="20" label="PQRS" letters="pq rs"/>
    <key id="r3c4" width="20" label="ABC" letters="abc" lean="off"/>
    <key id="r3c5" width="20" label="XYZ" letters="xyz"/>
  </row>
</keyboard>
