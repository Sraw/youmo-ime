<?xml version="1.0" encoding="UTF-8"?>
<keyboard xmlns="https://youmo-ime/layout/1" id="k18" name="18 键" family="grouped" columns="100">
  <defaults kind="letter" text-size="20" width="fill"/>
  <row>
    <key id="r1c1" label="{group:q}" shortcut="g18/q" letters="q"/>
    <key id="r1c2" label="{group:we}" shortcut="g18/we" letters="we"/>
    <key id="r1c3" label="{group:rt}" shortcut="g18/rt" letters="rt"/>
    <key id="r1c4" label="{group:y}" shortcut="g18/y" letters="y"/>
    <key id="r1c5" label="{group:u}" shortcut="g18/u" letters="u"/>
    <key id="r1c6" label="{group:io}" shortcut="g18/io" letters="io"/>
    <key id="r1c7" label="{group:p}" shortcut="g18/p" letters="p"/>
  </row>
  <row>
    <key id="r2c1" label="{group:a}" shortcut="g18/a" width="fill" letters="a"/>
    <key id="r2c2" label="{group:sd}" shortcut="g18/sd" width="fill" letters="sd"/>
    <key id="r2c3" label="{group:fg}" shortcut="g18/fg" width="fill" letters="fg"/>
    <key id="r2c4" label="{group:h}" shortcut="g18/h" width="fill" letters="h"/>
    <key id="r2c5" label="{group:jk}" shortcut="g18/jk" width="fill" letters="jk"/>
    <key id="r2c6" label="{group:l}" shortcut="g18/l" width="fill" letters="l;">
      <variant when="ime=shuangpin scheme-types=semicolon" label="{group:l;}"/>
    </key>
  </row>
  <row>
    <key id="apostrophe" label="分词" kind="function" role="apostrophe" text-size="16" a11y="a11y_key_separator" send="'" shortcut="separator" width="15"/>
    <key id="r3c1" label="{group:z}" shortcut="g18/z" width="14" letters="z"/>
    <key id="r3c2" label="{group:xc}" shortcut="g18/xc" width="14" letters="xc"/>
    <key id="r3c3" label="{group:v}" shortcut="g18/v" width="14" letters="v"/>
    <key id="r3c4" label="{group:bn}" shortcut="g18/bn" width="14" letters="bn"/>
    <key id="r3c5" label="{group:m}" shortcut="g18/m" width="14" letters="m"/>
    <key id="backspace" icon="backspace" kind="function" role="backspace" a11y="a11y_key_backspace" sound="delete" send="sym:BackSpace" swipe-axis="both" repeat="true" shortcut="backspace" width="15"/>
  </row>
  <include src="grouped-bottom"/>
</keyboard>
